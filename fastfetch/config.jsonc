{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none",
  },
  "display": {
    "separator": "  ",
    "key": {
      "width": 22, //21
      "paddingLeft": 4, //2
    },
    "size": {
      "binaryPrefix": "jedec",
    },
    "percent": {
      "type": 11,
    },
    "bar": {
      "border": {
        "left": "\uee00",
        "leftElapsed": "\uee03",
        "right": "\uee02",
        "rightElapsed": "\uee05",
      },
      "char": {
        "total": "\uee01",
        "elapsed": "\uee04",
      },
      "width": 49,
    },
  },
  "modules": [
    "break",
    {
      "type": "title",
      "format": "  ┏━━━━━━━━━━━━━━━━━━  {#yellow}{user-name}{#} @ {#yellow}{host-name}{#}  ━━━━━━━━━━━━━━━━━┓",
    },
    "break",
    {
      "key": "  User      ",
      "type": "title",
      "format": "{user-name}",
      "keyColor": "31",
    },
    {
      "key": " ⏱ Uptime    ",
      "type": "uptime",
      "keyColor": "31",
    },
    {
      "key": "  OS        ",
      "type": "os",
      "format": "{name} {version}",
      "keyColor": "32",
    },
    {
      "key": "  Kernel    ",
      "type": "kernel",
      "keyColor": "32",
    },
    {
      "key": " 󰨇 WM        ",
      "type": "wm",
      "format": "{pretty-name}",
      "keyColor": "33",
    },
    {
      "key": " 󰮯 PM        ",
      "type": "packages",
      "keyColor": "33",
    },
    {
      "key": "  Terminal  ",
      "type": "terminal",
      "keyColor": "33",
    },
    {
      "key": "  Shell     ",
      "type": "shell",
      "keyColor": "33",
    },
    {
      "type": "host",
      "key": "  Device    ",
      "keyColor": "34",
    },
    {
      "type": "cpu",
      "key": "  CPU       ",
      "format": "{name} @ {freq-max}",
      "keyColor": "34",
    },
    {
      "type": "gpu",
      "key": " 󰢮 GPU       ",
      "format": "{name}",
      "keyColor": "34",
    },
    {
      "key": "  RAM       ",
      "type": "memory",
      "keyColor": "34",
      "format": "{used} / {total} ({percentage})",
    },
    {
      "key": "  SWAP      ",
      "type": "swap",
      "keyColor": "34",
      "format": "{used} / {total} ({percentage})",
    },

    "break",
    {
      "type": "custom",
      "format": "  ┗━━━━━━━━━━━━━━━━━━━━━━━━━━ {#yellow}Welcome{#} ━━━━━━━━━━━━━━━━━━━━━━━━┛",
    },
    "break",
  ],
}
